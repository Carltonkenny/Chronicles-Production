# ─── LLM Provider (primary: deepseek) ────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
LLM_PROVIDER=deepseek

# ─── LLM Fallbacks ───────────────────────────────────────────────
GROQ_API_KEY=your_groq_key
OPENROUTER_API_KEY=your_openrouter_key

# ─── GPU Video Service ───────────────────────────────────────────
VIDEO_PROVIDER=cloud_gpu
CLOUD_GPU_ENDPOINT=https://xxx.jarvislabs.ai
CLOUD_GPU_API_KEY=chronicles-gpu-key-2026

# ─── Redis (optional, LRU fallback works without it) ─────────────
REDIS_URL=redis://localhost:6379

# ─── Supabase (optional, SQLite fallback works without it) ───────
SUPABASE_URL=
SUPABASE_KEY=

# ─── AWS / Cloudflare R2 (optional, for production storage) ──────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
