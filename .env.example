# Pollinations AI Configuration
# Get API key at: https://auth.pollinations.ai
# Recommended: gemini-fast (3.8K rate limit, free tier, ~4000+ char output)
# Alternatives: deepseek (300 rate), grok (good but higher cost)
POLLINATIONS_MODEL=gemini-fast
POLLINATIONS_API_KEY=your_key_here

# Amazon Polly Credentials
# Get keys at: https://console.aws.amazon.com/iam
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_key_here
AWS_REGION=ap-southeast-1
